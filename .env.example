# Copy this file to .env and fill in the values. All are optional for local dev.

# MongoDB connection string (defaults to mongodb://127.0.0.1:27017/GoHost)
ATLASDB_URL=

# Secret used to sign session cookies and encrypt stored sessions
SECRET=change-me

# Port to listen on (defaults to 8080)
PORT=8080

# Cloudinary image uploads (without these, uploads are saved to public/uploads)
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=

# Mapbox token for geocoding + the map on listing pages (without it, no map is shown)
MAP_TOKEN=
