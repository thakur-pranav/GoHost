<% layout("/layouts/boilerplate") %>
  <div class="row mt-3">
    <div class="col-md-8 offset-md-3">
      <h3><%= listing.title %></h3>
    </div>
    <div class="card col-md-6 offset-md-3 show-card listing-card">
      <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing_image">
      <div class="card-body">
        <p class="card-text mt-3">
          <i>Owned by <%= listing.owner ? listing.owner.username : "GoHost" %></i>
        </p>
        <p class="card-text"><%= listing.description %></p>
        <p class="card-text">&#8377; <%= (listing.price || 0).toLocaleString("en-IN") %> / night</p>
        <p class="card-text"><%= listing.location %>, <%= listing.country %></p>
      </div>
    </div>

    <% if(currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %>
      <div class="btns col-md-6 offset-md-3 mb-3">
        <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark edit-btn">Edit</a>
        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
<%- csrfField() %>
          <button class="btn btn-dark">Delete</button>
        </form>
      </div>
    <% } %>

    <div class="col-md-6 offset-md-3 mb-3">
      <div class="booking-card">
        <h4 class="mb-1">&#8377; <%= (listing.price || 0).toLocaleString("en-IN") %> <span class="fs-6 fw-normal">/ night</span></h4>

        <% if(currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %>
          <p class="text-muted mb-0">This is your listing. <a href="/bookings">See its bookings</a>.</p>
        <% } else if(!currUser) { %>
          <p class="mb-0"><a href="/login">Log in</a> to book this place.</p>
        <% } else { %>
          <form action="/listings/<%= listing._id %>/bookings" method="POST" novalidate class="needs-validation mt-3" id="booking-form"
                data-price="<%= listing.price || 0 %>">
<%- csrfField() %>
            <div class="row g-2">
              <div class="col-6">
                <label for="checkIn" class="form-label">Check-in</label>
                <input type="date" id="checkIn" name="booking[checkIn]" min="<%= today %>" class="form-control" required>
              </div>
              <div class="col-6">
                <label for="checkOut" class="form-label">Check-out</label>
                <input type="date" id="checkOut" name="booking[checkOut]" min="<%= today %>" class="form-control" required>
              </div>
              <div class="col-12">
                <label for="guests" class="form-label">Guests</label>
                <input type="number" id="guests" name="booking[guests]" min="1" max="20" value="1" class="form-control" required>
              </div>
            </div>
            <p class="booking-estimate mt-3 mb-2" id="booking-estimate"></p>
            <button class="btn btn-dark add-btn w-100 mt-2">Reserve</button>
          </form>
        <% } %>

        <% if(bookedStays.length > 0) { %>
          <hr>
          <p class="mb-1"><b>Already booked</b></p>
          <ul class="booked-list mb-0">
            <% for(let stay of bookedStays) { %>
              <li><%= displayDay(stay.checkIn) %> &rarr; <%= displayDay(stay.checkOut) %></li>
            <% } %>
          </ul>
        <% } %>
      </div>
    </div>

    <div class="col-md-8 offset-md-3 mb-3">
      <% if(currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %>
        <%# owners can't review their own listing %>
      <% } else if(currUser) { %>
        <hr>
        <h4>Leave a Review</h4>
        <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
<%- csrfField() %>
          <div class="mb-3 mt-3">
            <label class="form-label">Rating</label>
            <fieldset class="starability-slot">
              <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="" checked aria-label="No rating." />
              <input type="radio" id="first-rate1" name="review[rating]" value="1" />
              <label for="first-rate1" title="Terrible">1 star</label>
              <input type="radio" id="first-rate2" name="review[rating]" value="2" />
              <label for="first-rate2" title="Not good">2 stars</label>
              <input type="radio" id="first-rate3" name="review[rating]" value="3" />
              <label for="first-rate3" title="Average">3 stars</label>
              <input type="radio" id="first-rate4" name="review[rating]" value="4" />
              <label for="first-rate4" title="Very good">4 stars</label>
              <input type="radio" id="first-rate5" name="review[rating]" value="5" />
              <label for="first-rate5" title="Amazing">5 stars</label>
            </fieldset>
          </div>
          <div class="mb-3 mt-3">
            <label for="comment" class="form-label">Comments</label>
            <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control" required></textarea>
            <div class="invalid-feedback">Please add some comments for review.</div>
          </div>
          <button class="btn btn-outline-dark">Submit</button>
        </form>
      <% } else { %>
        <hr>
        <p><a href="/login">Log in</a> to leave a review.</p>
      <% } %>

      <% if(listing.reviews.length > 0) { %>
        <hr>
        <p><b>All Reviews</b></p>
        <div class="row">
          <% for(let review of listing.reviews) { %>
            <div class="card col-md-5 ms-md-3 mb-3 review-card">
              <div class="card-body">
                <h5 class="card-title">@<%= review.author ? review.author.username : "deleted user" %></h5>
                <p class="starability-result card-text" data-rating="<%= review.rating %>">
                  Rated: <%= review.rating %> stars
                </p>
                <p class="card-text"><%= review.comment %></p>
              </div>
              <% if(currUser && review.author && review.author._id.equals(currUser._id)) { %>
                <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" class="mb-3" method="POST">
<%- csrfField() %>
                  <button class="btn btn-sm btn-dark">Delete</button>
                </form>
              <% } %>
            </div>
          <% } %>
        </div>
      <% } %>
    </div>

    <script src="/js/booking.js"></script>

    <% if(mapToken && listing.geometry && listing.geometry.coordinates && listing.geometry.coordinates.length === 2) { %>
      <div class="col-md-6 offset-md-3 mb-3">
        <hr>
        <h3>Where you'll be</h3>
        <div id="map"
             data-token="<%= mapToken %>"
             data-coordinates="<%= JSON.stringify(listing.geometry.coordinates) %>"
             data-title="<%= listing.title %>"></div>
      </div>
      <link href="https://api.mapbox.com/mapbox-gl-js/v3.9.2/mapbox-gl.css" rel="stylesheet">
      <script src="https://api.mapbox.com/mapbox-gl-js/v3.9.2/mapbox-gl.js"></script>
      <script src="/js/map.js"></script>
    <% } %>
  </div>
