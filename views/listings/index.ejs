<% layout("/layouts/boilerplate") %>

<div id="filters">
    <a href="/listings" class="filter <%= !category ? 'active' : '' %>">
        <div><i class="fa-solid fa-border-all"></i></div>
        <p>All</p>
    </a>
    <% for(let c of categories) { %>
        <a href="/listings?category=<%= c.value %>" class="filter <%= category === c.value ? 'active' : '' %>">
            <div><i class="fa-solid <%= c.icon %>"></i></div>
            <p><%= c.label %></p>
        </a>
    <% } %>

    <div class="tax-toggle">
        <div class="form-check-reverse form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="taxSwitch">
            <label class="form-check-label" for="taxSwitch">Display total after taxes</label>
        </div>
    </div>
</div>

<% if(q) { %>
    <p class="mt-3">Showing results for "<b><%= q %></b>" &middot; <a href="/listings">clear</a></p>
<% } %>

<% if(allListings.length === 0) { %>
    <div class="text-center text-muted my-5">
        <p>No listings found.</p>
        <a href="/listings" class="btn btn-outline-dark">See all listings</a>
    </div>
<% } %>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
    <% for(let listing of allListings) { %>
        <a href="/listings/<%= listing._id %>" class="listing-link">
            <div class="card col listing-card">
                <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_img" style="height: 20rem;">
                <div class="card-img-overlay"></div>
                <div class="card-body">
                    <p class="card-text">
                        <b><%= listing.title %></b><br>
                        &#8377; <%= (listing.price || 0).toLocaleString("en-IN") %> / night
                        <i class="tax-info"> &nbsp; +18% GST</i>
                    </p>
                </div>
            </div>
        </a>
    <% } %>
</div>

<script>
    document.getElementById("taxSwitch").addEventListener("change", (e) => {
        for (const info of document.querySelectorAll(".tax-info")) {
            info.style.display = e.target.checked ? "inline" : "none";
        }
    });
</script>
