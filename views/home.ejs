<% layout("/layouts/boilerplate") %>

<div class="home">
    <i class="fa-regular fa-compass home-icon"></i>
    <h1 class="mt-3">Welcome to GoHost</h1>
    <p class="text-muted">Find a place to stay, or share your own with travellers.</p>
    <div class="d-flex gap-3 justify-content-center mt-3">
        <a href="/listings" class="btn btn-dark add-btn">Get Started</a>
        <% if(!currUser) { %>
            <a href="/signup" class="btn btn-outline-dark">Sign Up</a>
        <% } %>
    </div>
</div>
